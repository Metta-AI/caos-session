#!/usr/bin/env bash
# The script interpreter, identical to std/bash/worker: fetch the next
# executable in the chain (`worker1`) and run it with bash. If the script left
# no result, store an empty blob so there is something for caos to read.
set -euo pipefail
caos get /cas/args/worker1
bash /cas/args/worker1
if [ ! -e /cas/out ]; then
  : > /tmp/caos-empty-out
  caos put /tmp/caos-empty-out /cas/out
fi
