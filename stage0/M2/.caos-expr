# Phase 5: build M2-Planet from cc_amd64.
#
# A C compiler for a larger subset of C, and the last compiler here that is not
# built by itself. cc_amd64 turns its sources into M1, which M0 and hex2-0 then
# assemble and link.
SCRIPT=<<END
./catm ./M2-0.c \
	./M2libc/amd64/linux/bootstrap.c \
	./M2-Planet/cc.h \
	./M2libc/bootstrappable.c \
	./M2-Planet/cc_globals.c \
	./M2-Planet/cc_reader.c \
	./M2-Planet/cc_strings.c \
	./M2-Planet/cc_types.c \
	./M2-Planet/cc_emit.c \
	./M2-Planet/cc_core.c \
	./M2-Planet/cc_macro.c \
	./M2-Planet/cc.c
./cc_amd64 ./M2-0.c ./M2-0.M1
./catm ./M2-0-0.M1 ./AMD64/amd64_defs.M1 ./AMD64/libc-core.M1 ./M2-0.M1
./M0 ./M2-0-0.M1 ./M2-0.hex2
./catm ./M2-0-0.hex2 ./AMD64/ELF-amd64.hex2 ./M2-0.hex2
./hex2-0 ./M2-0-0.hex2 ./out
END
run --base:@=DEEP-DEPS/step --script=$SCRIPT --catm:@=DEEP-DEPS/catm --cc_amd64:@=DEEP-DEPS/cc_amd64 --M0:@=DEEP-DEPS/M0 --hex2-0:@=DEEP-DEPS/hex2-0
